# Để trống / '/api/v1' khi dev (Vite proxy) hoặc production có rewrite cùng domain.
# Chỉ set URL tuyệt đối khi FE và BE khác domain — khi đó BE cần COOKIE_SAMESITE=none + HTTPS.
VITE_API_URL=/api/v1
# Target của Vite proxy khi dev
VITE_BE_PROXY=http://localhost:4000
# Hiện nút đăng nhập Google (BE phải cấu hình GOOGLE_CLIENT_ID/SECRET)
VITE_GOOGLE_LOGIN_ENABLED=false
